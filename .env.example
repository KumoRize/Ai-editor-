# Copy to .env (never commit it). Everything here stays on the server.

# Code you type on your phone to use the editor
ACCESS_TOKEN=change-me

# Planner: auto | anthropic | openai | rules
LLM_PROVIDER=auto
# Optional: Claude planner
ANTHROPIC_API_KEY=
# Optional: any OpenAI-compatible API (OpenAI, OpenRouter, local Ollama ...)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Model id (required for the openai provider; defaults to claude-opus-5-5 for anthropic)
LLM_MODEL=
LLM_EFFORT=medium

MAX_UPLOAD_MB=500
UPLOAD_RETENTION_HOURS=48
RENDER_RETENTION_HOURS=72
WORKER_THREADS=1
X264_PRESET=veryfast
